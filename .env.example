# 高德地图 API Key（去 https://lbs.amap.com/ 申请，详见 docs/01_第一步_项目初始化.md）
# JS API Key：服务平台选"Web 端 (JS API)"，用于浏览器定位
VITE_AMAP_JS_KEY=

# JS API 安全密钥（创建 Key 时高德自动生成，在控制台 Key 列表的"安全密钥"列）
# 2021 年之后新建的 JS API Key 必须配合此码使用，否则定位报错
VITE_AMAP_JS_SECRET=

# Web 服务 Key：服务平台选"Web 服务"，用于周边搜索 REST API
VITE_AMAP_WEB_KEY=

# 定位失败时的兜底坐标（"经度,纬度"，默认北京天安门）
# 建议改成你所在城市，例如：上海人民广场 121.475,31.230 / 广州天河 113.330,23.135
VITE_FALLBACK_LOCATION=116.397,39.909
